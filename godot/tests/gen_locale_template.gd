## Dev tool: (re)generates a locale file containing EVERY translatable string
## in the game, so a translator's checklist can't drift from what the game
## actually contains — same guarantee, and same preserve-existing-work
## behaviour, as tests/gen_art_manifest.gd.
##
##   godot --headless --path godot -s tests/gen_locale_template.gd -- fr
##
## Existing translations are preserved; only new keys are added, and keys
## whose English source has CHANGED since the translation was written are
## reported so a stale translation can't quietly survive a rewrite of the
## original line.
##
## Writes data/base/locale/<lang>.json. The English source for every key is
## kept alongside in a parallel "_source" block, so a translator can work in
## the file itself without cross-referencing the data files.
extends SceneTree

var content: Node
var art: Node


func _initialize() -> void:
	content = root.get_node("Content")
	art = root.get_node("Art")
	await process_frame
	content.reload()
	art.reload()

	var args := OS.get_cmdline_user_args()
	var lang := args[0] if args.size() > 0 else "fr"
	if lang == "en":
		printerr("'en' is the source language — the .gd literals and base JSON are already English; no locale file needed.")
		quit(1)
		return

	var path := "res://data/base/locale/%s.json" % lang
	var existing := _load_existing(path)
	var prev_source: Dictionary = existing.get("_source", {})
	var prev_strings: Dictionary = existing.get("locale_" + lang, {})

	var source := _collect_sources()

	var out_strings := {}
	var added: Array[String] = []
	var stale: Array[String] = []
	for key in source:
		var eng: String = source[key]
		var had: String = str(prev_strings.get(key, ""))
		out_strings[key] = had
		if not prev_strings.has(key):
			added.append(key)
		elif had != "" and prev_source.has(key) and str(prev_source[key]) != eng:
			stale.append(key)

	var dropped: Array = prev_strings.keys().filter(func(k): return not source.has(k))

	var doc := {
		"_comment": "GENERATED by tests/gen_locale_template.gd — re-run it after adding or changing any UI string or content record; existing translations are preserved. Fill in the values under \"locale_%s\"; an empty string means untranslated and the game falls back to the English in \"_source\". See docs/LOCALIZATION.md." % lang,
		"_source": source,
		"locale_" + lang: out_strings,
	}
	DirAccess.make_dir_recursive_absolute("res://data/base/locale")
	var f := FileAccess.open(path, FileAccess.WRITE)
	f.store_string(JSON.stringify(doc, "  ") + "\n")
	f.close()

	var done := 0
	for k in out_strings:
		if str(out_strings[k]) != "":
			done += 1
	print("wrote %s — %d keys, %d translated (%d%%)" % [path, out_strings.size(), done, 0 if out_strings.is_empty() else round(100.0 * done / out_strings.size())])
	if not added.is_empty():
		print("  +%d new key(s)" % added.size())
	if not stale.is_empty():
		printerr("  %d translation(s) whose English source CHANGED — review these: %s" % [stale.size(), ", ".join(stale.slice(0, 10))])
	if not dropped.is_empty():
		printerr("  %d key(s) no longer exist and were dropped: %s" % [dropped.size(), ", ".join(dropped.slice(0, 10))])
	quit(0)


## Every translatable string in the game, keyed the way I18n looks them up.
func _collect_sources() -> Dictionary:
	var src := {}

	# 1. UI chrome. The English source doubles as the key (see I18n.t), so what
	#    goes in here is whatever the .gd files hand to I18n.t().
	#
	#    SCRAPED FIRST, then topped up by hand. It used to be the hand list
	#    alone, with a comment saying a reliable scraper was more than this
	#    needed — and the list fell behind by about a hundred strings, including
	#    most of the reading screen. The French build showed "Left to draw 5"
	#    and "You have not said anything yet. Elle est looking at your hands."
	#    while the coverage counter read 100%, because it counts the table and
	#    the table is what was incomplete. A checklist that quietly stops
	#    listing things is worse than no checklist.
	#
	#    The hand list stays for what a scrape CANNOT see: Run.gd emits display
	#    strings as bare data (see its header's display-string convention) and
	#    they reach I18n.t() through UIKit.tr_line() with no literal at the call
	#    site.
	for s in _scraped_ui_strings():
		src["ui/" + s] = s
	for s in _ui_strings():
		src["ui/" + s] = s

	# 2. Content, addressed by the same slug ids the art manifest uses.
	for pool in ["cards_basics", "cards_chroma", "cards_minor", "cards_arcana"]:
		for c in content.registries.get(pool, []):
			var id: String = art.card_id(c)
			_put(src, id + "/n", c.get("n", ""))
			_put(src, id + "/fl", c.get("fl", ""))
	for r in content.readers:
		var rid: String = art.reader_id(r)
		_put(src, rid + "/name", r.get("name", ""))
		_put(src, rid + "/sign", r.get("sign", ""))
		_put(src, rid + "/line", r.get("line", ""))
		_put(src, rid + "/rule", r.get("rule", ""))
	for s in content.sitters:
		_put_sitter(src, art.sitter_id(s), s)
	if not content.boss.is_empty():
		_put_sitter(src, art.sitter_id(content.boss), content.boss)
	for sg in content.signs:
		var sid: String = "sign/" + str(sg.get("k", ""))
		_put(src, sid + "/n", sg.get("n", ""))
		_put(src, sid + "/dn", sg.get("dn", ""))
		_put(src, sid + "/rule", sg.get("rule", ""))
		_put(src, sid + "/fl", sg.get("fl", ""))
	# Pronoun words. A locale needs its own set (il/elle/iel and whatever verb
	# agreement it takes) — these are substituted into sign rules at display
	# time by I18n.fill(), so leaving them in English would put English words
	# inside otherwise-translated sentences.
	for pk in content.pronouns:
		var table: Dictionary = content.pronouns[pk]
		for token in table:
			_put(src, "pronoun/" + pk + "/" + token, table[token])
	for role in content.jobs:
		_put(src, "job/" + art.slug(role) + "/t", content.jobs[role].get("t", ""))
		_put(src, "job/" + art.slug(role) + "/fl", content.jobs[role].get("fl", ""))
		_put(src, "job/" + art.slug(role) + "/role", role)
	for el in content.elements:
		var e: Dictionary = content.elements[el]
		_put(src, "element/" + el + "/label", e.get("label", ""))
		_put(src, "element/" + el + "/gives", e.get("gives", ""))
		_put(src, "element/" + el + "/body", e.get("body", ""))
	for m in content.marks + content.relics:
		_put(src, "mark/" + art.slug(str(m.get("n", ""))) + "/n", m.get("n", ""))
		_put(src, "mark/" + art.slug(str(m.get("n", ""))) + "/text", m.get("text", ""))
	for ev in content.events:
		var eid: String = "event/" + art.slug(str(ev.get("title", "")))
		_put(src, eid + "/title", ev.get("title", ""))
		_put(src, eid + "/body", ev.get("body", ""))
		_put(src, eid + "/head", ev.get("head", ""))
		_put(src, eid + "/line", ev.get("line", ""))
		var oi := 0
		for opt in ev.get("opts", []):
			_put(src, "%s/opt%d/kind" % [eid, oi], opt.get("kind", ""))
			_put(src, "%s/opt%d/name" % [eid, oi], opt.get("name", ""))
			_put(src, "%s/opt%d/text" % [eid, oi], opt.get("text", ""))
			oi += 1
	# Minitel services. The terminal's fixed chrome is deliberately untranslated
	# (see Minitel.gd), but what a SERVICE prints is prose an author wrote, and
	# a mod's terminal may well be set somewhere other than France.
	for code in content.minitel_codes:
		var lines: Array = content.minitel_codes[code].get("screen", [])
		for li in lines.size():
			_put(src, "minitel/%s/screen%d" % [code, li], lines[li])
	# The card archetypes' one-line descriptions — the source's own words for
	# what each family of card is for. Shown in a card's tooltip.
	# WHAT BECOMES OF THE VILLAGE. Four endings, three paragraphs each, and the
	# last thing anybody reads — and they were in no template at all, so the
	# French build closed a run in English.
	for e in content.endings:
		var eid: String = "ending/" + art.slug(str(e.get("head", "")))
		_put(src, eid + "/head", e.get("head", ""))
		_put(src, eid + "/village", e.get("village", ""))
		_put(src, eid + "/reader", e.get("reader", ""))

	for key in content.archetypes:
		# The NAME as well as the description. It used to be the registry id in
		# upper case, printed straight, so a French tooltip read "TIMING — Une
		# bonne syntaxe fait beaucoup" — half in each language.
		_put(src, "archetype/" + key + "/name", key.to_upper())
		_put(src, "archetype/" + key + "/text", content.archetypes[key].get("text", ""))
	for tw in content.elite_twists:
		var tid: String = "twist/" + art.slug(str(tw.get("tag", "")))
		_put(src, tid + "/tag", tw.get("tag", ""))
		_put(src, tid + "/t", tw.get("t", ""))
	if not content.shop.is_empty():
		for k in ["title", "body", "head", "line", "burn_name", "burn_text"]:
			_put(src, "shop/" + k, content.shop.get(k, ""))
	return src


func _put_sitter(src: Dictionary, id: String, s: Dictionary) -> void:
	_put(src, id + "/name", s.get("name", ""))
	_put(src, id + "/role", s.get("role", ""))
	_put(src, id + "/brings", s.get("brings", ""))
	_put(src, id + "/win", s.get("win", ""))
	_put(src, id + "/fail", s.get("fail", ""))


func _put(src: Dictionary, key: String, value) -> void:
	var s := str(value).strip_edges()
	if s != "":
		src[key] = s


## Keep in step with the I18n.t() calls in scenes/*.gd.
## Every `I18n.t("…")` literal in the game's own source. Deliberately narrow:
## only a double-quoted literal directly inside the call, which is how all of
## them are written — anything computed is a key from data and is covered by the
## content half of this file.
func _scraped_ui_strings() -> Array[String]:
	var out: Array[String] = []
	var seen := {}
	for dir_path in ["res://scenes", "res://autoload"]:
		for path in _gd_files(dir_path):
			var text := FileAccess.get_file_as_string(path)
			var at := 0
			while true:
				var call_at := text.find("I18n.t(\"", at)
				if call_at < 0:
					break
				var start := call_at + 8
				var s := ""
				var i := start
				while i < text.length():
					var c := text[i]
					if c == "\\" and i + 1 < text.length():
						# A literal quote or backslash inside the string.
						s += text[i + 1] if text[i + 1] != "n" else "\n"
						i += 2
						continue
					if c == "\"":
						break
					s += c
					i += 1
				at = i + 1
				if s != "" and not seen.has(s):
					seen[s] = true
					out.append(s)
	out.sort()
	return out


func _gd_files(dir_path: String) -> Array[String]:
	var out: Array[String] = []
	var d := DirAccess.open(dir_path)
	if d == null:
		return out
	d.list_dir_begin()
	var name := d.get_next()
	while name != "":
		var full := dir_path.path_join(name)
		if d.current_is_dir():
			if not name.begins_with("."):
				out.append_array(_gd_files(full))
		elif name.ends_with(".gd"):
			out.append(full)
		name = d.get_next()
	d.list_dir_end()
	return out


