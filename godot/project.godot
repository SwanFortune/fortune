; Engine configuration file.
config_version=5

[application]

config/name="Parlour"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/art/icon.svg"

[autoload]

Settings="*res://autoload/Settings.gd"
Workshop="*res://autoload/Workshop.gd"
Content="*res://autoload/Content.gd"
Art="*res://autoload/Art.gd"
Audio="*res://autoload/Audio.gd"
I18n="*res://autoload/I18n.gd"
Rules="*res://autoload/Rules.gd"
Run="*res://autoload/Run.gd"
Save="*res://autoload/Save.gd"
Profile="*res://autoload/Profile.gd"
Minitel="*res://autoload/Minitel.gd"
Version="*res://autoload/Version.gd"
Icons="*res://autoload/Icons.gd"
CardEdits="*res://autoload/CardEdits.gd"
Nav="*res://autoload/Nav.gd"

[display]

; WITHOUT THIS the interface renders at 1:1 pixels whatever the window size, so
; going fullscreen on a 1080p screen leaves the same tiny text stranded in more
; empty space — the video settings added in the previous commit actively made
; the game harder to read, which is the opposite of what a resolution setting
; is for. Godot's default is stretch/mode "disabled"; nothing had ever set it
; because the whole port was developed at the default window size.
;
; canvas_items scales the UI with the window. "expand" scales by the smaller of
; the two ratios and gives the extra space on the other axis to more VIEW
; rather than to bars — right for an interface that is columns and lists, where
; a wider window should show more, not letterbox.
;
; Settings' ui_scale multiplies on top of this (Viewport.content_scale_factor),
; so it goes back to meaning "and a bit bigger than that" instead of being the
; only thing that made a big display usable.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

; ui_accept and ui_cancel ARE redefined here, and the reason is worth writing
; down because the previous comment in this spot said the opposite and was
; wrong. It claimed the built-ins "already carry sensible defaults on keyboard
; and gamepad" and so left them alone. They do not: as this project loads them,
; ui_accept is Enter/KpEnter/Space and ui_cancel is Escape, with no joypad
; button on either — while ui_left/ui_down DO arrive with their D-pad and stick
; events, which is what made the gap invisible. A gamepad could move the
; highlight around every screen in the game and never confirm anything.
;
; So both are declared with their keyboard defaults unchanged plus the buttons
; every controller player expects: A to confirm, B to go back. Redefining them
; is safe — Button responds to whatever events ui_accept carries — and
; tests/test_settings.gd now fails if any action a player needs is left without
; a joypad event.
;
; Both stay rebindable: see Settings.ACTIONS, which lists them alongside the
; game's own actions and rewrites whichever the player changes (keyboard only,
; so a rebind never costs someone their controller button).
ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194310,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":false,"script":null)
]
}
ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":1,"pressure":0.0,"pressed":false,"script":null)
]
}
parlour_read={
